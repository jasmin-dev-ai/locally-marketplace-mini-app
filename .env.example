# ─── Telegram Bot Configuration ──────────────────────────────────────────────
# Obtain your bot token from @BotFather on Telegram
VITE_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Store Admin Telegram Chat ID (for order alert notifications)
# Find yours by messaging @userinfobot on Telegram
VITE_TELEGRAM_ADMIN_CHAT_ID=

# ─── Cloudflare Workers Deployment URL ───────────────────────────────────────
# The public URL of your deployed Cloudflare Worker / Pages project.
# After deployment, run:  node scripts/setup-bot.mjs
# to register the Telegram menu button with this URL.
VITE_APP_URL=https://your-project.your-subdomain.workers.dev
VITE_WEBAPP_URL=https://your-project.your-subdomain.workers.dev
